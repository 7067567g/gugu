{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gugu.dev/prodline/contracts/artifact-manifest/v1",
  "title": "artifact-manifest/v1",
  "description": "Authoritative manifest for the A-to-B artifact set: artifact.zip + this manifest as two sibling files (the manifest is never embedded in the zip). v1 is additive-only; changing type/enum/required is a v2 break.",
  "type": "object",
  "required": [
    "schema",
    "commit",
    "git_tree",
    "provenance",
    "product_version",
    "desktop_version",
    "upstream_kernel_version",
    "upstream_tag",
    "artifact_sha256",
    "artifact_bytes",
    "files_sha256",
    "files_count",
    "files_manifest",
    "built_at",
    "runner",
    "dirty",
    "lockfiles",
    "includes",
    "excludes",
    "build_receipt_sha256",
    "producer"
  ],
  "properties": {
    "schema": {
      "const": "artifact-manifest/v1"
    },
    "commit": {
      "$ref": "#/$defs/commit"
    },
    "git_tree": {
      "$ref": "#/$defs/commit",
      "description": "git rev-parse <commit>^{tree}; the only member excluded when rebuilding the tree is the synthetic FILES.sha256."
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "product_version": {
      "$ref": "#/$defs/version",
      "description": "GUGU_VERSION (0.9.0), not pyproject.toml and not the desktop version."
    },
    "desktop_version": {
      "$ref": "#/$defs/version",
      "description": "apps/desktop/package.json#version (0.17.6); the NSIS artifact name uses this."
    },
    "upstream_kernel_version": {
      "$ref": "#/$defs/version",
      "description": "pyproject.toml#[project].version (0.21.5)."
    },
    "upstream_tag": {
      "$ref": "#/$defs/tag",
      "description": "arch/upstream.lock#tag (v0.22.5)."
    },
    "artifact_sha256": {
      "$ref": "#/$defs/sha256_prefixed",
      "description": "sha256 of artifact.zip bytes."
    },
    "artifact_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "files_sha256": {
      "$ref": "#/$defs/sha256_prefixed",
      "description": "sha256 of the FILES.sha256 text itself."
    },
    "files_count": {
      "type": "integer",
      "minimum": 1,
      "description": "Line count of FILES.sha256; must equal the real line count."
    },
    "files_manifest": {
      "const": "FILES.sha256"
    },
    "built_at": {
      "$ref": "#/$defs/timestamp",
      "description": "Human-readable only; never used in any equality check."
    },
    "runner": {
      "$ref": "#/$defs/runner"
    },
    "dirty": {
      "const": false,
      "description": "A dirty source tree must never be published; true is rejected by the schema."
    },
    "lockfiles": {
      "$ref": "#/$defs/lockfiles"
    },
    "includes": {
      "$ref": "#/$defs/includes"
    },
    "excludes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Excluded globs, kept for B-side audit; the checker independently rejects forbidden trees present in the zip."
    },
    "build_receipt_sha256": {
      "$ref": "#/$defs/sha256_prefixed",
      "description": "sha256 of the build-receipt/v1 that produced this artifact."
    },
    "producer": {
      "$ref": "#/$defs/producer"
    },
    "commit_short": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,39}$"
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "git_archive": {
      "$ref": "#/$defs/git_archive"
    },
    "extra_artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/extra_artifact"
      }
    },
    "payloads": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/payload"
      }
    },
    "fixture_reason": {
      "type": "string",
      "minLength": 1,
      "description": "Required by the gate when provenance != real; never set on a real publish."
    }
  },
  "additionalProperties": true,
  "$defs": {
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "provenance": {
      "enum": ["real", "fixture", "mock", "accelerated"]
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+[.][0-9]+[.][0-9]+([-+][0-9A-Za-z.-]+)?$"
    },
    "tag": {
      "type": "string",
      "pattern": "^v[0-9]+[.][0-9]+[.][0-9]+([-+][0-9A-Za-z.-]+)?$"
    },
    "sha256_prefixed": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "runner": {
      "type": "object",
      "required": ["os", "image", "arch", "python", "uv", "node", "npm", "git"],
      "properties": {
        "os": {"type": "string", "minLength": 1},
        "image": {"type": "string", "minLength": 1},
        "arch": {"type": "string", "minLength": 1},
        "python": {"type": "string", "minLength": 1},
        "uv": {"type": "string", "minLength": 1},
        "node": {"type": "string", "minLength": 1},
        "npm": {"type": "string", "minLength": 1},
        "git": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "lockfiles": {
      "type": "object",
      "required": ["uv.lock", "package-lock.json"],
      "properties": {
        "uv.lock": {"$ref": "#/$defs/sha256_prefixed"},
        "package-lock.json": {"$ref": "#/$defs/sha256_prefixed"}
      },
      "additionalProperties": true
    },
    "includes": {
      "type": "object",
      "required": ["pyproject.toml", "GUGU_VERSION", "scripts/install.ps1"],
      "properties": {
        "pyproject.toml": {"const": true},
        "GUGU_VERSION": {"const": true},
        "scripts/install.ps1": {"const": true}
      },
      "additionalProperties": true
    },
    "producer": {
      "type": "object",
      "required": ["stage", "tool", "contract_version"],
      "properties": {
        "stage": {"const": "build"},
        "tool": {"const": "prodline/stages/build.py"},
        "contract_version": {"const": 1}
      },
      "additionalProperties": true
    },
    "git_archive": {
      "type": "object",
      "properties": {
        "format": {"const": "zip"},
        "compression_level": {"type": "integer", "minimum": 1, "maximum": 9},
        "generator": {"type": "string", "minLength": 1},
        "git_version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "extra_artifact": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256_prefixed"},
        "kind": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 1},
        "built_by": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "payload": {
      "type": "object",
      "required": ["name", "root", "files_sha256"],
      "properties": {
        "name": {"enum": ["kernel", "glue", "extensions"]},
        "root": {"type": "string", "minLength": 1},
        "files_sha256": {"$ref": "#/$defs/sha256_prefixed"}
      },
      "additionalProperties": true
    }
  }
}
