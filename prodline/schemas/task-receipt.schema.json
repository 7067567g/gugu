{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gugu.dev/prodline/schemas/task-receipt/v1",
  "title": "task-receipt/v1",
  "description": "Evidence for one task sample: hashes, verification result, duration, cost and retries. Produced during the runtime stage.",
  "type": "object",
  "required": ["schema", "commit", "generated_at", "stage", "provenance", "status"],
  "properties": {
    "schema": {
      "const": "task-receipt/v1"
    },
    "commit": {
      "$ref": "#/$defs/commit"
    },
    "generated_at": {
      "$ref": "#/$defs/timestamp"
    },
    "stage": {
      "const": "runtime"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "status": {
      "$ref": "#/$defs/status"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "input_hash": {
      "$ref": "#/$defs/sha256_ref"
    },
    "output_hash": {
      "$ref": "#/$defs/sha256_ref"
    },
    "verify": {
      "type": "boolean"
    },
    "verdict": {
      "enum": ["pass", "fail", "skip"]
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "cost_usd": {
      "type": "number",
      "minimum": 0
    },
    "retries": {
      "type": "integer",
      "minimum": 0
    },
    "model": {
      "type": "string"
    },
    "started_at": {
      "$ref": "#/$defs/timestamp"
    },
    "finished_at": {
      "$ref": "#/$defs/timestamp"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence_ref"
      }
    },
    "producer": {
      "$ref": "#/$defs/producer"
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence_ref"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "provenance": {
      "enum": ["real", "fixture", "mock", "accelerated"]
    },
    "status": {
      "enum": ["pass", "fail", "skip"]
    },
    "sha256_ref": {
      "type": "string",
      "pattern": "^(sha256:)?[0-9a-f]{64}$"
    },
    "evidence_ref": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256_ref"
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "producer": {
      "type": "object",
      "properties": {
        "stage": {
          "type": "string"
        },
        "tool": {
          "type": "string"
        },
        "contract_version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": true
    }
  }
}
